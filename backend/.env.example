# ==============================================================================
# EduGraph AI - Multi-Agent & LLM Configuration (CrewAI Edition)
# ==============================================================================

# LLM Provider Options: gemini | groq | openai | openrouter | ollama
# (If left unset, the system will auto-detect based on whichever key is provided below)
LLM_PROVIDER=gemini

# 1. Google Gemini (Recommended - Generous Free Tier via Google AI Studio)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini/gemini-1.5-flash

# 2. Groq (High-Speed Free Tier Llama 3)
# Get a free key at: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here
# LLM_MODEL=groq/llama-3.3-70b-versatile

# 3. OpenAI
# OPENAI_API_KEY=your_openai_key_here
# LLM_MODEL=gpt-4o-mini

# 4. OpenRouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. Local Ollama (Completely Offline & Free)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=ollama/llama3.2

# Server & Database Settings
PORT=4000
DB_PATH=../data/edugraph.db
CHROMA_PATH=../data/chroma
JWT_SECRET=edugraph_ai_super_secret_jwt_key_gate_2025_prod
