# ==============================================================================
# EduGraph AI - configuration (copy to backend/.env; never commit real keys)
# ==============================================================================

# ---- Security -----------------------------------------------------------------
# REQUIRED in production. Generate with:  openssl rand -hex 48
# If unset, an ephemeral secret is generated at start-up (everyone is logged out on restart).
JWT_SECRET=
# Comma-separated emails allowed to read /api/agents/token-report
ADMIN_EMAILS=
# Comma-separated browser origins allowed to call the API cross-origin (empty = same-origin only)
CORS_ORIGIN=

# ---- LLM ---------------------------------------------------------------------
# Provider: gemini | groq | openai | openrouter | ollama  (auto-detected from whichever key is set)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Complex tasks (concept explanations, solutions)
# LLM_MODEL=gemini-2.5-flash
# Cheap/simple tasks (quick doubts, recall, flashcards, PYQ insight). Defaults to LLM_MODEL.
# LLM_MODEL_FAST=gemini-2.5-flash-lite
LLM_TIMEOUT_MS=30000
# Retries on 429/5xx/network errors (exponential backoff, hard-capped at 3)
LLM_MAX_RETRIES=2
# Embedding model for semantic retrieval (run `npm run embed` once after ingesting data)
# EMBEDDING_MODEL=gemini-embedding-001
# Minimum embedding cosine for a query the lexical gate refused (calibrated on evaluation/test_cases.json)
# SEMANTIC_GATE=0.62
# Route Concept Teacher / PYQ Analyst / Problem Solver through real CrewAI crews (needs python3 + `pip install -r backend/crewai/requirements.txt`)
USE_CREWAI=true
CREWAI_TIMEOUT_MS=60000
# PYTHON_BIN=/path/to/python3

# ---- Server & data -------------------------------------------------------------
PORT=4000
DB_PATH=../data/edugraph.db
# Where the ingestion pipeline writes processed GATE papers (default: data/gate_papers/processed)
# GATE_PROCESSED_DIR=
# Rate limits (requests per window per user/IP)
# RATE_LIMIT_AUTH=60     # per 10 minutes
# RATE_LIMIT_AI=40       # per minute
# RATE_LIMIT_API=300     # per minute

# ---- Text-to-speech ------------------------------------------------------------
# browser (default, free) | elevenlabs
TTS_PROVIDER=browser
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
